#!/usr/bin/env node
import { mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { dirname, resolve } from 'node:path'
import * as spec from './commands.js'

const TIMEOUT_MS = 5000

function usage() {
  const lines = ['usage: tabhell <command> [positional ...] [--flag] [--flag=value]', '']
  for (const [name, command] of Object.entries(spec.commands)) {
    const names = slots(command.params, {}).map((key) => '<' + key + '>').join(' ')
    lines.push('  ' + (name + ' ' + names).padEnd(44) + command.help)
  }
  lines.push('')
  lines.push('  ' + 'install-host <browser-directory>'.padEnd(44) + 'register the native host')
  lines.push('      e.g. tabhell install-host ~/.config/google-chrome')
  lines.push('  ' + 'uninstall-host <browser-directory>'.padEnd(44) + 'remove the native host')
  return lines.join('\n')
}

const TARGET = 'tabId|host'

function looksNumeric(value) {
  return value !== '' && Number.isInteger(Number(value))
}

// Commands that accept either a tabId or a host spend one positional on both.
function slots(schema, params) {
  const names = []
  for (const key of Object.keys(schema)) {
    const shared = schema.tabId !== undefined && schema.host !== undefined &&
      (key === 'tabId' || key === 'host')
    if (shared) {
      const taken = params.tabId !== undefined || params.host !== undefined
      if (!taken && !names.includes(TARGET)) {
        names.push(TARGET)
      }
    } else if (params[key] === undefined) {
      names.push(key)
    }
  }
  return names
}

function parseArgv(argv, schema) {
  const params = {}
  const positional = []

  for (const arg of argv) {
    if (arg.startsWith('--')) {
      const eq = arg.indexOf('=')
      if (eq === -1) {
        params[arg.slice(2)] = 'true'
      } else {
        params[arg.slice(2, eq)] = arg.slice(eq + 1)
      }
    } else {
      positional.push(arg)
    }
  }

  // Positionals fill the schema's own key order, skipping anything a flag set.
  const free = slots(schema, params)
  positional.forEach((value, i) => {
    if (i < free.length) {
      if (free[i] === TARGET) {
        params[looksNumeric(value) ? 'tabId' : 'host'] = value
      } else {
        params[free[i]] = value
      }
    }
  })
  return params
}

const [action, ...rest] = process.argv.slice(2)

if (!action || action === 'help' || action === '--help') {
  console.log(usage())
  process.exit(0)
}

// install/uninstall

const HOST_MANIFEST = 'cc.shitpoet.tabhell.json'

function hostManifestPath(browserDir) {
  return resolve(browserDir, 'NativeMessagingHosts', HOST_MANIFEST)
}

function installHost(browserDir) {
  const here = import.meta.dirname
  const host = JSON.parse(readFileSync(resolve(here, HOST_MANIFEST), 'utf8'))
  host.path = resolve(here, 'tabhell.mjs')
  const path = hostManifestPath(browserDir)
  mkdirSync(dirname(path), { recursive: true })
  rmSync(path, { force: true })  // an old symlink here would write into the repo
  writeFileSync(path, JSON.stringify(host, null, 2) + '\n')
}

function uninstallHost(browserDir) {
  rmSync(hostManifestPath(browserDir), { force: true })
}

const hostCommands = { 'install-host': installHost, 'uninstall-host': uninstallHost }

const hostCommand = hostCommands[action]
if (hostCommand !== undefined) {
  if (rest.length === 1) {
    hostCommand(rest[0])
    process.exit(0)
  } else {
    console.error('usage: tabhell ' + action + ' <browser-directory>')
    process.exit(1)
  }
}

// normal commands

const command = spec.commands[action]
if (command === undefined) {
  console.error('unknown command: ' + action + '\n\n' + usage())
  process.exit(1)
}

const params = parseArgv(rest, command.params)
const url = new URL('http://127.0.0.1:' + spec.resolvePort(process.env) + '/' + action)
for (const [key, value] of Object.entries(params)) {
  url.searchParams.set(key, value)
}

let response = null
try {
  response = await fetch(url, { signal: AbortSignal.timeout(TIMEOUT_MS) })
} catch (e) {
  console.error('tabhell host unreachable on ' + url.host + ': ' + String(e))
  process.exit(1)
}

if (response.headers.get('content-type') === 'image/png') {
  process.stdout.write(Buffer.from(await response.arrayBuffer()))
  process.exit(0)
}

const reply = JSON.parse(await response.text())

if (reply.ok) {
  if (typeof reply.result === 'string') {
    console.log(reply.result)
  } else {
    console.log(JSON.stringify(reply.result, null, 2))
  }
  process.exit(0)
} else {
  console.error(reply.result)
  process.exit(1)
}
