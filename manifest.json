{
  "manifest_version": 3,
  "name": "tabhell",
  "version": "0.1.0",
  "description": "Control tabs, bookmarks and page scripts from outside the browser.",
  "key": "",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "bookmarks", "favicon", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"]
}
